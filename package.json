{
  "name": "cowmanagementservice",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "version:get": "node scripts/version.cjs get",
    "version:bump": "node scripts/version.cjs bump",
    "version:set": "npm version --no-git-tag-version",
    "version": "node scripts/sync-version.cjs",
    "version:sync": "node scripts/sync-version.cjs",
    "test:version": "node --test tests/version.test.cjs",
    "test:unit": "node --test",
    "test:ui": "tsc -p tsconfig.vitest.json && vitest run",
    "test": "npm run test:unit && npm run test:ui",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:desktop": "tauri build",
    "build:exe": "tauri build --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
