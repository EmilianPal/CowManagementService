{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferma",
  "version": "1.0.0",
  "identifier": "com.lenovo.cowmanagementservice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ferma · Manager de bovine",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Romanian"],
        "customLanguageFiles": { "Romanian": "installer/Romanian.nsh" },
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
